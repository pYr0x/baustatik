{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "pkg/**",
        ".next/**",
        "!.next/cache/**",
        ".output/**"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**/*.tsx",
        "src/**/*.ts",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "rust/**/*.rs",
        "rust/Cargo.toml"
      ]
    },
    "@baustatik/mesh-2d-wasm#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "native/**",
        "vendor/triangle/triangle.c",
        "vendor/triangle/triangle.h",
        "scripts/build.mjs",
        "../../scripts/docker-wasm.mjs",
        "../../docker/Dockerfile.emscripten",
        "toolchain.json",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": ["pkg/**"]
    },
    "@baustatik/mesh-2d-wasm#test": {
      "dependsOn": ["build"],
      "inputs": [
        "src/**",
        "tests/**",
        "native/**",
        "vendor/triangle/triangle.c",
        "vendor/triangle/triangle.h",
        "scripts/build.mjs",
        "toolchain.json",
        "package.json",
        "tsconfig.json",
        "vitest.config.ts"
      ],
      "outputs": ["coverage/**"]
    },
    "@baustatik/sparse-solver-wasm#test": {
      "dependsOn": ["build"],
      "inputs": [
        "rust/**/*.rs",
        "rust/Cargo.toml",
        "rust/Cargo.lock",
        "scripts/run-with-toolchain.mjs",
        "../../scripts/docker-wasm.mjs",
        "../../docker/Dockerfile.rust",
        "package.json"
      ]
    },
    "@baustatik/sparse-solver-wasm#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "rust/**",
        "scripts/run-with-toolchain.mjs",
        "../../scripts/docker-wasm.mjs",
        "../../docker/Dockerfile.rust",
        "package.json"
      ],
      "outputs": ["pkg/**"]
    },
    "@baustatik/linear-solver-wasm#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "rust/**",
        "scripts/run-with-toolchain.mjs",
        "../../scripts/docker-wasm.mjs",
        "../../docker/Dockerfile.rust",
        "package.json"
      ],
      "outputs": ["pkg/**"]
    },
    "@baustatik/linear-solver-wasm#test": {
      "dependsOn": ["build"],
      "inputs": [
        "rust/**/*.rs",
        "rust/Cargo.toml",
        "rust/Cargo.lock",
        "scripts/run-with-toolchain.mjs",
        "../../scripts/docker-wasm.mjs",
        "../../docker/Dockerfile.rust",
        "package.json"
      ]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
