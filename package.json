    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "turbo": "^2.8.7",
    "typescript": "^5.9.3",
    "wrangler": "^4.121.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.16.0"
}
