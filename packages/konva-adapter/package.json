{
  "name": "@baustatik/konva-adapter",
  "version": "0.0.3",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run --project Unit --project Browser",
    "test:node": "vitest run --project Unit",
    "test:browser": "vitest run --project Browser",
    "test:screenshot": "vitest run --project Screenshot",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix .",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@baustatik/render-core": "workspace:*",
    "@baustatik/viewport-2d": "workspace:*",
    "konva": "^10.3.0"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-istanbul": "^4.1.5",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.5"
  }
}
