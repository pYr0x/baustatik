{
  "name": "@baustatik/fem-section-resolve",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix .",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@baustatik/cross-section": "workspace:*",
    "@baustatik/fem": "workspace:*",
    "@baustatik/fem-element": "workspace:*",
    "@baustatik/material": "workspace:*"
  },
  "devDependencies": {
    "@baustatik/fem-solver": "workspace:*",
    "@baustatik/script": "workspace:*",
    "@baustatik/steel-profiles": "workspace:*",
    "@vitest/coverage-istanbul": "^4.1.5",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.5"
  }
}
