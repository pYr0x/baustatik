{
  "name": "@baustatik/cross-section-stress",
  "version": "0.0.3",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "lint": "oxlint --fix .",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@baustatik/cross-section": "workspace:*",
    "@baustatik/errors": "workspace:*",
    "@baustatik/section-forces": "workspace:*",
    "@baustatik/units": "workspace:*"
  },
  "devDependencies": {
    "@baustatik/steel-profiles": "workspace:*",
    "@vitest/coverage-istanbul": "^4.1.11",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  }
}
