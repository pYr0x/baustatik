{
  "name": "@baustatik/cross-section-viewer",
  "version": "0.0.12",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run --project Unit --project Browser",
    "test:node": "vitest run --project Unit",
    "test:browser": "vitest --project Browser",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix .",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@baustatik/cross-section": "workspace:*",
    "@baustatik/errors": "workspace:*",
    "@baustatik/grid-2d": "workspace:*",
    "@baustatik/render-core": "workspace:*",
    "@baustatik/section-geometry": "workspace:*",
    "@baustatik/units": "workspace:*",
    "@baustatik/viewport-2d": "workspace:*"
  },
  "devDependencies": {
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-istanbul": "^4.0.18",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "playwright": "^1.58.2",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  }
}
