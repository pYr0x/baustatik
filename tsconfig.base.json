{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@baustatik/core": [
        "packages/core/src/index.ts"
      ],
      "@baustatik/errors": [
        "packages/errors/src/index.ts"
      ],
      "@baustatik/round": [
        "packages/round/src/index.ts"
      ],
      "@baustatik/units": [
        "packages/units/src/index.ts"
      ],
      "@baustatik/geometry-2d": [
        "packages/geometry-2d/src/index.ts"
      ],
      "@baustatik/material": [
        "packages/material/src/index.ts"
      ],
      "@baustatik/section-geometry": [
        "packages/section-geometry/src/index.ts"
      ],
      "@baustatik/grid-2d": [
        "packages/grid-2d/src/index.ts"
      ],
      "@baustatik/render-core": [
        "packages/render-core/src/index.ts"
      ],
      "@baustatik/viewport-2d": [
        "packages/viewport-2d/src/index.ts"
      ],
      "@baustatik/konva-adapter": [
        "packages/konva-adapter/src/index.ts"
      ],
      "@baustatik/cross-section-viewer": [
        "packages/cross-section-viewer/src/index.ts"
      ],
      "@baustatik/cross-section": [
        "packages/cross-section/src/index.ts"
      ],
      "@baustatik/fem": [
        "packages/fem/src/index.ts"
      ],
      "@baustatik/fem-geometry": [
        "packages/fem-geometry/src/index.ts"
      ],
      "@baustatik/fem-viewer": [
        "packages/fem-viewer/src/index.ts"
      ]
    }
  }
}
